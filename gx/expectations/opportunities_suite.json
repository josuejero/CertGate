{
  "expectation_suite_name": "opportunities_suite",
  "data_asset_type": "pandas",
  "meta": {
    "notes": "Opportunity schema, stage, and amount expectations for the CRM integrity gate.",
    "contributors": [
      "CertGate CRM Integrity Gate"
    ],
    "great_expectations_version": "0.17.0"
  },
  "ge_cloud_id": null,
  "evaluation_parameters": {},
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "opportunity_id",
          "account_id",
          "owner_id",
          "stage",
          "amount",
          "created_at",
          "close_date",
          "last_stage_change_at",
          "next_step",
          "forecast_category"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "opportunity_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "opportunity_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "stage",
        "value_set": [
          "Discovery",
          "Qualification",
          "Proposal",
          "Negotiation",
          "Closed Won",
          "Closed Lost"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "amount",
        "min_value": 0
      }
    }
  ]
}
