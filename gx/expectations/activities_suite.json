          "activity_id",
          "object_type",
          "object_id",
          "activity_type",
          "activity_at",
          "owner_id",
          "outcome"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "activity_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "activity_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "object_type",
        "value_set": [
          "lead",
          "account",
          "opportunity"
        ]
      }
    }
  ]
