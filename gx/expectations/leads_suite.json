{
  "expectation_suite_name": "leads_suite",
  "data_asset_type": "pandas",
  "meta": {
    "notes": "Lead schema, identity, and lifecycle assertions for the CRM integrity gate.",
    "contributors": [
      "CertGate CRM Integrity Gate"
    ],
    "great_expectations_version": "0.17.0"
  },
  "ge_cloud_id": null,
  "evaluation_parameters": {},
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "lead_id",
          "email",
          "first_name",
          "last_name",
          "company_name",
          "company_domain",
          "job_title",
          "owner_id",
          "lead_source",
          "lifecycle_stage",
          "lead_status",
          "created_at",
          "last_activity_at",
          "account_id"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "lead_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "email"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "lead_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "email"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "lifecycle_stage",
        "value_set": [
          "Subscriber",
          "Lead",
          "MQL",
          "SQL",
          "Opportunity",
          "Customer"
        ]
      }
    }
  ]
}
