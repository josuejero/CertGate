        after: "reports/demo/after/release_decision.json",
        duplicateDomains: "reports/ops_insights/duplicate_domains.json",
        staleOpportunities: "reports/ops_insights/stale_opportunities.json",
        ownerWorkload: "reports/ops_insights/owner_workload.json",
      };

      async function fetchJson(path) {
        const response = await fetch(path);
        if (!response.ok) {
          throw new Error(`Failed to load ${path}: ${response.status}`);
        }
        return response.json();
      }

      function setPill(status) {
        const pill = document.getElementById("status-pill");
        pill.textContent = status;
        pill.dataset.status = status.toLowerCase();
      }

      function renderSummaryList(targetId, items, emptyLabel) {
        const node = document.getElementById(targetId);
        node.innerHTML = "";
        if (!items || !items.length) {
          node.innerHTML = `<span class="pill">${emptyLabel}</span>`;
          return;
        }
        items.forEach((item) => {
          const pill = document.createElement("span");
          pill.className = "pill";
          pill.textContent = `${item.name}: ${item.count}`;
          node.appendChild(pill);
        });
      }

      function renderMetric(id, value) {
        document.getElementById(id).textContent = value ?? "—";
      }

      function renderComparisonCard(prefix, payload) {
        document.getElementById(`${prefix}-status`).textContent = payload.status;
        document.getElementById(`${prefix}-reason`).textContent = payload.decision_reason;
      }

      function renderWeeklySummary(summary) {
        const node = document.getElementById("weekly-summary");
        node.innerHTML = `
          <p><strong>Bundle:</strong> ${summary.bundle_name}</p>
          <p><strong>Critical issues:</strong> ${summary.critical_issues}</p>
          <p><strong>Warning issues:</strong> ${summary.warning_issues}</p>
          <p><strong>Duplicate domains:</strong> ${summary.duplicate_domains}</p>
          <p><strong>Stale opportunities:</strong> ${summary.stale_opportunities_over_threshold}</p>
          <p><strong>No-next-step deals:</strong> ${summary.open_opportunities_with_no_next_step}</p>
        `;
      }

      function renderInsightsPreview(duplicateDomains, staleOpportunities, ownerWorkload) {
        const node = document.getElementById("insights-preview");
        node.innerHTML = `
          <p><strong>Duplicate domains:</strong> ${duplicateDomains.length}</p>
          <p><strong>Stale opportunities:</strong> ${staleOpportunities.length}</p>
          <p><strong>Owner workload rows:</strong> ${ownerWorkload.length}</p>
        `;
      }

      document.addEventListener("DOMContentLoaded", async () => {
        const demoLink = document.getElementById("demo-link");
        demoLink.href = window.location.href;

        try {
          const [
            decision,
            validation,
            weekly,
            before,
            after,
            duplicateDomains,
            staleOpportunities,
            ownerWorkload
          ] = await Promise.all([
            fetchJson(reportPaths.release),
            fetchJson(reportPaths.validation),
            fetchJson(reportPaths.weekly),
            fetchJson(reportPaths.before),
            fetchJson(reportPaths.after),
            fetchJson(reportPaths.duplicateDomains),
            fetchJson(reportPaths.staleOpportunities),
            fetchJson(reportPaths.ownerWorkload)
          ]);

          setPill(decision.status);
          document.getElementById("status-text").textContent = decision.status;
          document.getElementById("status-reason").textContent = decision.decision_reason;
          document.getElementById("sync-status").textContent = decision.status;
          document.getElementById("sync-summary").textContent = decision.decision_reason;

          renderMetric("records-scanned", validation.records_scanned);
          renderMetric("critical-count", validation.severity_counts.critical);
          renderMetric("warning-count", validation.severity_counts.warning);
          renderMetric("rule-count", validation.rule_count);

          renderComparisonCard("before", before);
          renderComparisonCard("after", after);
          renderSummaryList("owners-list", validation.top_affected_owners, "No owner hotspots");
          renderSummaryList("stages-list", validation.top_affected_stages, "No stage hotspots");
          renderWeeklySummary(weekly);
          renderInsightsPreview(duplicateDomains, staleOpportunities, ownerWorkload);
        } catch (error) {
          console.error(error);
          document.getElementById("status-text").textContent = "Artifacts pending";
          document.getElementById("status-reason").textContent =
            "Run the pipeline and publish reports to refresh this dashboard.";
        }
      });
    </script>
