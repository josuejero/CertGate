{
  "expectation_suite_name": "owners_suite",
  "data_asset_type": "pandas",
  "meta": {
    "notes": "Owner schema and identity expectations for the CRM integrity gate.",
    "contributors": [
      "CertGate CRM Integrity Gate"
    ],
    "great_expectations_version": "0.17.0"
  },
  "ge_cloud_id": null,
  "evaluation_parameters": {},
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "owner_id",
          "owner_name",
          "owner_email",
          "team",
          "manager",
          "is_active"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "owner_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "owner_email"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "owner_id"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "owner_email"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "is_active",
        "value_set": [
          true,
          false
        ]
      }
    }
  ]
}
